# Node / frontend
dashboard/node_modules/
dashboard/dist/

# Rust / Tauri
dashboard/src-tauri/target/

# Python
.venv/
__pycache__/
*.pyc

# Models (large binaries, fetch separately)
voice/models/
*.onnx
*.bin
*.gguf

# Local secrets
phone/.env
*.key

# Audio artifacts
*.wav

# Runtime logs
os-bridge/actions.log
activity.log
conversation_log.md
learning_log.md
.last_reflected_ts

# macOS
.DS_Store

# File-bridge runtime data — files you actually dropped in / backups of
# your real files, not something to track in git
inbox/*
backups/*
!inbox/.gitkeep
!backups/.gitkeep
