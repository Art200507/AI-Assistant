{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS Dashboard",
  "version": "0.1.0",
  "identifier": "com.jarvis.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "J.A.R.V.I.S. — Status",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#04070a",
        "fullscreen": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
